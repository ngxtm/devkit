{
  "name": "@ngxtm/devkit",
  "version": "3.5.0",
  "description": "Per-project AI skills with smart tech detection - lightweight and context-optimized",
  "main": "cli/index.js",
  "bin": {
    "devkit": "cli/index.js"
  },
  "scripts": {
    "build": "npm run merge-commands && npm run organize-rules && npm run generate-index",
    "merge-commands": "node scripts/merge-commands.js",
    "organize-rules": "node scripts/organize-rules.js",
    "generate-index": "node scripts/generate-index.js",
    "test": "node cli/index.js detect",
    "sync:upstream": "node scripts/manual-sync.js",
    "validate": "python scripts/validate_skills.py"
  },
  "files": [
    "cli/",
    "merged-commands/",
    "templates/",
    "skills/",
    "rules/",
    "scripts/merge-commands.js",
    "scripts/organize-rules.js",
    "scripts/generate-index.js",
    "hooks/",
    "skills-index.json",
    "rules-index.json",
    "SKILLS_INDEX.md"
  ],
  "keywords": [
    "ai",
    "claude",
    "cursor",
    "copilot",
    "agent",
    "skills",
    "coding-assistant"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngxtm/devkit.git"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "semantic-release": "^22.0.12"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ]
    ]
  }
}
